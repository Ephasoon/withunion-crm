# ════════════════════════════════════════════════════════════
#  WithUnion CRM — Environment Template
#  Copy this file to `.env` and fill in your own values.
#     Windows PowerShell:  Copy-Item .env.example .env
#     macOS / Linux:       cp .env.example .env
# ════════════════════════════════════════════════════════════

# ─── Server ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Uploaded documents are stored here, outside public/ (git-ignored).
STORAGE_DIR=./storage/uploads


# ════════════════════════════════════════════════════════════
#  DATABASE — pick ONE of the two options below
# ════════════════════════════════════════════════════════════

# ─── OPTION 1: Local PostgreSQL (development) ───────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=withunion_crm
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here


# ─── OPTION 2: Supabase / Neon / Railway (production) ───────
# When DATABASE_URL is set it overrides all DB_* values above.
#
# Supabase → Project Settings → Database → Connection string
#   Transaction pooler (port 6543) = use for DATABASE_URL
#   Direct connection  (port 5432) = use for DIRECT_URL
#
# DATABASE_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# DIRECT_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Force TLS on/off (auto-detected for known providers — usually leave blank)
# DB_SSL=true

# Connection pool size (auto-detected: 1 serverless / 10 managed / 20 local)
# DB_MAX_CONNECTIONS=10


# ─── Organization Defaults ──────────────────────────────────
ORG_NAME=WithUnion Technologies
ORG_SLUG=withunion
ORG_CURRENCY=ETB
ORG_COUNTRY=Ethiopia
ORG_TIMEZONE=Africa/Addis_Ababa
ORG_TAX_RATE=15
ORG_COMMISSION_RATE=5


# ─── Sessions & Demo Login ──────────────────────────────────
# Sessions are opaque random tokens stored (SHA-256 hashed) in the sessions
# table and sent as an httpOnly cookie. No JWT secret is required.
SESSION_TTL_DAYS=7

# Password assigned to every seeded demo account. Change before any shared or
# public deployment, then re-run `npm run db:seed`.
DEMO_PASSWORD=Withunion2024!


# ─── AI Providers (optional) ────────────────────────────────
# Leave blank to use the built-in offline AI response engine.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# ─── Supabase Storage & Auth (optional) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ─── Payment Gateways (optional) ────────────────────────────
CHAPA_SECRET_KEY=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
STRIPE_SECRET_KEY=


# ─── Notifications (optional) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
